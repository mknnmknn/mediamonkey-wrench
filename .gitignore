# --- Secrets ---------------------------------------------------------------
# Never commit. WordPress Application Passwords and similar live here.
secrets.json
secrets.*.json
!secrets.example.json
.env
.env.*
!.env.example

# --- MediaMonkey library data ----------------------------------------------
# Database copies and their SQLite sidecars. Personal + large.
*.DB
*.DB-shm
*.DB-wal
*.db
*.db-shm
*.db-wal

# --- Per-user runtime / caches ---------------------------------------------
# Generated by tools at runtime; ignored at any depth.
*_cache.json
top_artists_history.json
bandcamp_collection.json
recap_*.html
data/
**/data/

# --- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.egg-info/
build/
dist/

# --- Editors / OS ----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
